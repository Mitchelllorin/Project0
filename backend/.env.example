# Copy this file to backend/.env for local development.
# server.py reads these at import time, so all three are required.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=kitchen_studio
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Deployment identity (one deployment = one client) ------------------------
# The branding and default catalog of *this* instance. All optional: anything left
# unset falls back to the built-in defaults. A manufacturer or distributor is
# onboarded by setting these, never by editing code. See DEPLOY.md.
# BRAND_NAME=Northline Cabinetry
# BRAND_SUBTITLE=Kitchen Configurator
# BRAND_ACCENT=#4f8cff
# BRAND_LOGO_URL=https://cdn.example.com/logo.svg
# DEFAULT_CATALOG=northline-example
