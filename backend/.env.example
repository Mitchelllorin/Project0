# Copy this file to backend/.env for local development.
# server.py reads these at import time, so all three are required.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=kitchen_studio
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Deployment identity (one deployment = one client) ------------------------
# The branding and default catalog of *this* instance. All optional: anything left
# unset falls back to the built-in defaults. A manufacturer or distributor is
# onboarded by setting these, never by editing code. See DEPLOY.md.
# BRAND_NAME=Northline Cabinetry
# BRAND_SUBTITLE=Kitchen Configurator
# BRAND_ACCENT=#4f8cff
# BRAND_LOGO_URL=https://cdn.example.com/logo.svg
# DEFAULT_CATALOG=northline-example

# --- Dealer accounts (one deployment, many dealers) ---------------------------
# Who may sign in to this instance and at what trade tier. Leave both unset and the
# studio is a public, list-price demo; set them and a dealer's code resolves on the
# server to that dealer's cost, margin and client price. See DEPLOY.md.
#   DEALERS='[{"id":"northline-01","name":"Northline Kitchen & Bath","code":"<long random>","tier":"trade"}]'
#   DEALER_TIERS='[{"id":"trade","name":"Trade","discount":0.35}]'
# Or point at a JSON file instead, which is what a real dealer list becomes:
#   DEALERS_FILE=/app/dealers.json
# DEALER_TIERS defaults to list 0% and trade 35% when unset.
