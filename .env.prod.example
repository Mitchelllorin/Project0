# One client, one instance. Copy to .env (`cp .env.prod.example .env`) and edit.
# Read by docker-compose.prod.yml as ${...} substitutions. See DEPLOY.md.

# Where this instance is served from. Used for the API's CORS allow-list, so it must
# be the origin the client actually opens.
PUBLIC_ORIGIN=http://localhost:8080
PORT=8080
DB_NAME=kitchen_studio

# --- Branding -----------------------------------------------------------------
# Left unset, the studio keeps its own neutral identity. A logo must be an HTTPS URL.
BRAND_NAME=
BRAND_SUBTITLE=
BRAND_ACCENT=
BRAND_LOGO_URL=

# --- Dealers ------------------------------------------------------------------
# Who may sign in to this instance, and at what trade price. Both are JSON; leave
# DEALERS empty and the studio runs as a public, list-price demo. See DEPLOY.md § 5.
#
#   DEALERS      [{"id":"northline-01","name":"Northline Kitchen & Bath",
#                  "code":"<a long random string>","tier":"trade","region":"NE"}]
#   DEALER_TIERS [{"id":"list","name":"List","discount":0},
#                 {"id":"trade","name":"Trade","discount":0.35}]
#
# The code is a shared secret: generate it, do not choose it, and never commit it.
#   openssl rand -base64 24
# Unset, the studio ships two tiers — list (0%) and trade (35%).
DEALERS=
DEALER_TIERS=
# Instead of inlining the list — which is what a manufacturer with more than a
# handful of dealers wants — name a JSON file and mount it into the api service
# (see the commented volume in docker-compose.prod.yml). The file wins when set.
DEALERS_FILE=
DEALER_TIERS_FILE=

# --- Catalogue ----------------------------------------------------------------
# The catalogue document in backend/catalog/ this instance configures from.
# An unknown or unrenderable name is reported at startup and falls back to euro32.
DEFAULT_CATALOG=euro32
