# One client, one instance. Copy to .env (`cp .env.prod.example .env`) and edit.
# Read by docker-compose.prod.yml as ${...} substitutions. See DEPLOY.md.

# Where this instance is served from. Used for the API's CORS allow-list, so it must
# be the origin the client actually opens.
PUBLIC_ORIGIN=http://localhost:8080
PORT=8080
DB_NAME=kitchen_studio

# --- Branding -----------------------------------------------------------------
# Left unset, the studio keeps its own neutral identity. A logo must be an HTTPS URL.
BRAND_NAME=
BRAND_SUBTITLE=
BRAND_ACCENT=
BRAND_LOGO_URL=

# --- Catalogue ----------------------------------------------------------------
# The catalogue document in backend/catalog/ this instance configures from.
# An unknown or unrenderable name is reported at startup and falls back to euro32.
DEFAULT_CATALOG=euro32
